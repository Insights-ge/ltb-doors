{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Sliding door builder payload",
    "type": "object",
    "additionalProperties": false,
    "required": ["catalog", "metadata"],
    "properties": {
        "catalog": {
            "type": "object",
            "additionalProperties": false,
            "required": ["models", "infills"],
            "properties": {
                "models": { "type": "array", "items": { "$ref": "#/$defs/model" } },
                "infills": { "type": "array", "items": { "$ref": "#/$defs/infill" } }
            }
        },
        "metadata": {
            "description": "Visual mappings and neutral fallbacks, kept separate from catalog facts.",
            "type": "object",
            "additionalProperties": false,
            "required": ["frameColors", "infillVisuals", "neutralVisual"],
            "properties": {
                "frameColors": { "type": "array", "items": { "$ref": "#/$defs/frameColor" } },
                "infillVisuals": { "type": "array", "items": { "$ref": "#/$defs/infillVisual" } },
                "neutralVisual": { "$ref": "#/$defs/visual" }
            }
        }
    },
    "$defs": {
        "visual": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fill"],
            "properties": {
                "fill": { "type": "string", "pattern": "^#[0-9A-F]{6}$" },
                "texture": { "enum": [null, "solid", "wood_straight", "wood_cathedral", "glass", "mirror"] }
            }
        },
        "frameColor": {
            "type": "object",
            "additionalProperties": false,
            "required": ["color", "label", "visual"],
            "properties": {
                "color": { "enum": ["black", "inox", "graphite", "silver"] },
                "label": { "type": "string" },
                "visual": { "$ref": "#/$defs/visual" }
            }
        },
        "infillVisual": {
            "type": "object",
            "additionalProperties": false,
            "required": ["infillId", "visual"],
            "properties": {
                "infillId": { "$ref": "#/$defs/id" },
                "visual": { "$ref": "#/$defs/visual" }
            }
        },
        "id": { "type": "integer", "minimum": 1 },
        "model": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "minHeight", "maxHeight", "minWidth", "maxWidth", "partitionCount", "notRecommendedHeightMin", "notRecommendedHeightMax", "variants"],
            "properties": {
                "id": { "$ref": "#/$defs/id" },
                "name": { "type": "string" },
                "minHeight": { "type": "integer" },
                "maxHeight": { "type": "integer" },
                "minWidth": { "type": "integer" },
                "maxWidth": { "type": "integer" },
                "partitionCount": { "type": "integer", "minimum": 1, "maximum": 4 },
                "notRecommendedHeightMin": { "type": ["integer", "null"] },
                "notRecommendedHeightMax": { "type": ["integer", "null"] },
                "variants": { "type": "array", "items": { "$ref": "#/$defs/variant" } }
            }
        },
        "variant": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "color", "frameDesignCode", "heightRangeMin", "heightRangeMax", "hasPartition", "hasSoftCloseMechanism", "components"],
            "properties": {
                "id": { "$ref": "#/$defs/id" },
                "name": { "type": "string" },
                "color": { "enum": ["black", "inox", "graphite", "silver"] },
                "frameDesignCode": { "type": "string" },
                "heightRangeMin": { "type": "integer" },
                "heightRangeMax": { "type": "integer" },
                "hasPartition": { "type": "boolean" },
                "hasSoftCloseMechanism": { "type": "boolean" },
                "components": { "type": "array", "items": { "$ref": "#/$defs/component" } }
            }
        },
        "component": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "incompatibleInfillIds", "code", "description", "color"],
            "properties": {
                "id": { "$ref": "#/$defs/id" },
                "type": { "enum": ["side_profile", "top_rail", "bottom_rail", "partition", "soft_close_mechanism"] },
                "code": { "type": "string" },
                "description": { "type": "string" },
                "color": { "enum": [null, "black", "inox", "graphite", "silver"] },
                "incompatibleInfillIds": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": { "$ref": "#/$defs/id" }
                }
            }
        },
        "infill": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "code", "description"],
            "properties": {
                "id": { "$ref": "#/$defs/id" },
                "code": { "type": "string" },
                "description": { "type": "string" }
            }
        }
    }
}
